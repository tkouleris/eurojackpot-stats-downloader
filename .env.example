# Copy to .env and fill in. See the Configuration section of README.md.

# Shared settings (eurojackpot.py, joker.py, lotto.py)
# Root folder of the Laravel app; php artisan runs there.
MAIN_DEST_PATH=
# Owner and group of the installed files (Linux only), e.g. www-data.
OWNER=
GROUP=

# Per game:
# <GAME>_DEST_PATH       folder of the app where the file is installed (must exist)
# <GAME>_CACHE_COMMAND   artisan command that refreshes the cache, without "php artisan"

# Eurojackpot
EUROJACKPOT_DEST_PATH=
EUROJACKPOT_CACHE_COMMAND=

# Joker
JOKER_DEST_PATH=
JOKER_CACHE_COMMAND=

# Lotto
LOTTO_DEST_PATH=
LOTTO_CACHE_COMMAND=
